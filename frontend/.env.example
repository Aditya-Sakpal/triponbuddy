VITE_CLERK_PUBLISHABLE_KEY=pk_test_clerk_key

VITE_GOOGLE_MAPS_API_KEY=google_maps_api_key

# Backend API (required for production)
VITE_API_BASE_URL=http://localhost:8000

# NEVER put GOOGLE_GEMINI / VITE_GOOGLE_GEMINI_API_KEY here.
# Gemini must only run on the backend. Browser-bundled keys get scraped and abused.
